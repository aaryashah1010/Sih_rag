# Copy to .env.local for running outside Docker (npm run dev). Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
NODE_DATABASE_URL=postgresql://node_runtime:node_dev_password@localhost:5432/ipsakti
NODE_MIGRATION_DATABASE_URL=postgresql://migration_owner:migration_dev_password@localhost:5432/ipsakti
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_TOKEN_SECRET=replace-with-at-least-32-random-characters-rag
RAG_TIMEOUT_MS=60000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-jwt
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PUBLIC_ORIGIN=http://localhost:5173
