# Copy to infra/docker/.env and replace every value for any shared or demo host.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POSTGRES_MIGRATION_PASSWORD=change-me-migration
NODE_RUNTIME_PASSWORD=change-me-node
RAG_RUNTIME_PASSWORD=change-me-rag
RAG_SERVICE_TOKEN_SECRET=change-me-at-least-32-characters-rag-token
JWT_ACCESS_SECRET=change-me-at-least-32-characters-jwt-access
PUBLIC_ORIGIN=http://localhost:5173
# Host ports (change if 5432/3000 are already used on your machine)
POSTGRES_HOST_PORT=5432
API_HOST_PORT=3000
